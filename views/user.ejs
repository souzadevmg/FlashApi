<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <title>Painel do Cliente | Flash API</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link href="/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/jquery.min.js"></script>
    <link href="/css/futuristic-theme.css" rel="stylesheet" />
</head>

<body class="panel-page user-page dashboard-page">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-black border-bottom border-primary">
        <div class="container-fluid">
            <a class="navbar-brand text-primary fw-bold" href="#"><i class="bi bi-lightning-charge-fill me-1"></i> Flash API</a>
            <div class="d-flex align-items-center gap-3">
                <span class="text-light small-muted d-none d-md-inline">APIKEY: <strong class="text-secondary"><%= userId %></strong></span>
                <a href="/manager/logout" class="btn btn-sm btn-danger">
                    <i class="bi bi-box-arrow-right me-1"></i> Sair
                </a>
            </div>
        </div>
    </nav>

    <div class="container mt-4">

        <div class="row mb-3">
            <div class="col-12">
                <h2 class="text-primary dashboard-title">Painel do Cliente</h2>
                <p class="small-muted mb-0">Gerencie sua instância com segurança: conexão, webhook, eventos e recursos.</p>
            </div>
        </div>

        <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <div id="userInfo" data-instance="<%= JSON.stringify(instances) %>" data-apikey="<%= userId %>"></div>

        <!-- ─── Instâncias ──────────────────────────────────────────── -->
        <section class="mb-5">
            <div class="row g-4">
                <% instances.forEach(instance => { %>
                    <div class="col-md-6 col-lg-4">
                        <div
                            class="card-instance"
                            data-nome="<%= instance.nome_sessao %>"
                            data-apikey="<%= instance.apikey %>"
                            data-numero="<%= instance.numero || '' %>"
                            data-status="<%= instance.status || 'disconnected' %>"
                        >

                            <!-- Header: foto + info -->
                            <div class="top-row mb-3">
                                <div class="d-flex align-items-center gap-3 flex-grow-1">
                                    <img
                                        src="/api/session/avatar/<%= instance.apikey %>?t=<%= Date.now() %>"
                                        alt="Foto de perfil"
                                        class="instance-avatar"
                                        data-fallback-src="/images/image.png"
                                    >
                                    <div class="flex-grow-1 overflow-hidden">
                                        <h5 class="text-primary mb-1 text-truncate instancia_nome">📱 <%= instance.nome_sessao %></h5>
                                        <div class="small-muted text-truncate instancia_apikey">🔑 <%= instance.apikey %></div>
                                        <% if (instance.numero) { %>
                                            <div class="small-muted instancia_numero">📞 <strong><%= instance.numero %></strong></div>
                                        <% } %>
                                    </div>
                                </div>
                                <div class="meta mt-1">
                                    <button class="btn copiar-btn" data-copy="<%= instance.nome_sessao %>" title="Copiar nome" aria-label="Copiar nome">
                                        <i class="bi bi-clipboard"></i>
                                    </button>
                                    <button class="btn copiar-btn" data-copy="<%= instance.apikey %>" title="Copiar APIKey" aria-label="Copiar APIKey">
                                        <i class="bi bi-clipboard-data"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Status -->
                            <p class="mb-3">
                                📊 Status:
                                <% if (instance.status === 'connected') { %>
                                    <span class="status-connected-badge badge_status_instancia"><i class="bi bi-check-circle-fill"></i> Conectado</span>
                                <% } else { %>
                                    <span class="status-disconnected-badge badge_status_instancia"><i class="bi bi-x-circle-fill"></i> Desconectado</span>
                                <% } %>
                            </p>

                            <!-- Ações -->
                            <div class="row row-cols-2 g-2">
                                <% if (instance.status !== 'connected') { %>
                                    <div class="col">
                                        <button class="btn-generate btn btn-sm btn-success w-100" data-apikey="<%= instance.apikey %>">
                                            <i class="bi bi-plug-fill me-1"></i><span class="btn-text">Conectar</span>
                                            <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                                        </button>
                                    </div>
                                <% } else { %>
                                    <div class="col">
                                        <button class="btn-restart btn btn-sm btn-success w-100" data-apikey="<%= instance.apikey %>">
                                            <i class="bi bi-arrow-repeat me-1"></i><span class="btn-text">Reiniciar</span>
                                            <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                                        </button>
                                    </div>
                                <% } %>

                                <div class="col">
                                    <button class="btn-disconnect btn btn-sm btn-danger w-100" data-apikey="<%= instance.apikey %>">
                                        <i class="bi bi-power me-1"></i><span class="btn-text">Desconectar</span>
                                        <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                                    </button>
                                </div>

                                <div class="col">
                                    <button class="btn-config btn btn-sm btn-secondary w-100" data-apikey="<%= instance.apikey %>">
                                        <i class="bi bi-gear me-1"></i><span class="btn-text">Configuração</span>
                                    </button>
                                </div>
                            </div>

                        </div>
                    </div>
                <% }) %>
            </div>
        </section>

    </div>

    <!-- ─── Modal QR Code ────────────────────────────────────────── -->
    <div class="modal fade" id="modalQR" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="modalQRLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content bg-dark text-white">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalQRLabel">📱 Conectar WhatsApp</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body text-center">
                    <div id="qr-code-info" class="mb-2"></div>
                    <img id="qr-code-img" class="img-fluid mt-2 border border-light rounded shadow" style="max-width:300px;" />
                    <div id="info-detalhes" class="mt-2"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ─── Modal Configuração ──────────────────────────────────── -->
    <div class="modal fade" id="configSessao" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="configSessaoLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content bg-dark text-white border border-primary">
                <div class="modal-header">
                    <h5 class="modal-title text-primary" id="configSessaoLabel">⚙️ Configuração da Sessão</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>

                <form id="form-config-Instance">
                    <div class="modal-body">

                        <div class="data-panel p-3 mb-3">
                            <h6 class="text-primary mb-2">Informações da Instância</h6>
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <div class="small-muted">ID da sessão</div>
                                    <div id="info-instancia-apikey" class="fw-semibold">-</div>
                                </div>
                                <div class="col-md-6">
                                    <div class="small-muted">Status atual</div>
                                    <div id="info-instancia-status" class="fw-semibold">-</div>
                                </div>
                                <div class="col-md-6">
                                    <div class="small-muted">Nome da sessão</div>
                                    <div id="info-instancia-nome" class="fw-semibold">-</div>
                                </div>
                                <div class="col-md-6">
                                    <div class="small-muted">Número</div>
                                    <div id="info-instancia-numero" class="fw-semibold">-</div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-secondary">🔗 URL Webhook</label>
                            <div class="input-group">
                                <span class="input-group-text border-primary border-2">URL:</span>
                                <input type="text" id="webhook-url" class="form-control border-primary border-2" placeholder="https://meuwebhook.com/api/receber">
                                <button type="button" id="btn-testar-webhook" class="btn btn-outline-info">
                                    <i class="bi bi-broadcast me-1"></i> Testar webhook
                                </button>
                            </div>
                            <div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox" id="webhook-status">
                                <label class="form-check-label" for="webhook-status">✅ Ativar webhook</label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-secondary">📋 Eventos do webhook</label>
                            <select class="form-select" name="events[]" id="events[]" multiple style="height:130px;">
                                <option value="connection_update">connection_update</option>
                                <option value="qr_updated">qr_updated</option>
                                <option value="message_received">message_received</option>
                                <option value="message_update">message_update</option>
                                <option value="chats_set">chats_set</option>
                                <option value="chats_update">chats_update</option>
                                <option value="contacts_set">contacts_set</option>
                                <option value="contacts_update">contacts_update</option>
                                <option value="groups_update">groups_update</option>
                                <option value="group_participants_update">group_participants_update</option>
                                <option value="presence_update">presence_update</option>
                                <option value="call">call</option>
                                <option value="messaging_history_set">messaging_history_set</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-secondary">🚫 Mensagem de rejeição</label>
                            <div class="input-group">
                                <span class="input-group-text border-primary border-2">Msg:</span>
                                <input type="text" id="mensagem-rejeicao" class="form-control border-primary border-2" placeholder="Chamada recusada.">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-6">
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox" id="rejeitar-chamada">
                                    <label class="form-check-label" for="rejeitar-chamada">📞 Rejeitar chamadas</label>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox" id="ignorar-grupos">
                                    <label class="form-check-label" for="ignorar-grupos">👥 Ignorar grupos</label>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox" id="sempre-online">
                                    <label class="form-check-label" for="sempre-online">🟢 Sempre online</label>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox" id="proxy-ativo">
                                    <label class="form-check-label" for="proxy-ativo">🟢 Proxy Ativo</label>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3 d-none" id="config-proxy">
                            <div class="mb-3 col-6">
                                <div class="input-group">
                                    <span class="input-group-text border-primary border-2">Protocol:</span>
                                    <input type="text" id="proxy-protocol" class="form-control border-primary border-2" placeholder="ex: http">
                                </div>
                            </div>

                            <div class="mb-3 col-6">
                                <div class="input-group">
                                    <span class="input-group-text border-primary border-2">Username:</span>
                                    <input type="text" id="proxy-username" class="form-control border-primary border-2" placeholder="ex: user123">
                                </div>
                            </div>

                            <div class="mb-3 col-6">
                                <div class="input-group">
                                    <span class="input-group-text border-primary border-2">Password:</span>
                                    <input type="text" id="proxy-password" class="form-control border-primary border-2" placeholder="ex: pass123">
                                </div>
                            </div>

                            <div class="mb-3 col-6">
                                <div class="input-group">
                                    <span class="input-group-text border-primary border-2">Port:</span>
                                    <input type="text" id="proxy-port" class="form-control border-primary border-2" placeholder="ex: 8080">
                                </div>
                            </div>

                            <div class="mb-3 col-6">
                                <div class="input-group">
                                    <span class="input-group-text border-primary border-2">Host:</span>
                                    <input type="text" id="proxy-host" class="form-control border-primary border-2" placeholder="ex: 127.0.0.1">
                                </div>
                            </div>
                        </div>

                        <div id="id_sessao" data-id=""></div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                        <button type="submit" class="btn btn-primary">
                            <span class="btn-text">💾 Salvar</span>
                            <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="containerNotificacoes" style="z-index: 1080;"></div>


    <script src="/js/user.js"></script>
</body>

</html>
