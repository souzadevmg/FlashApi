<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <title>Painel do Cliente | Flash API</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link href="/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/jquery.min.js"></script>
    <script src="/js/axios.js"></script>

    <link href="/css/futuristic-theme.css" rel="stylesheet" />
</head>

<body class="panel-page user-page">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-black border-bottom border-primary">
        <div class="container-fluid">
            <a class="navbar-brand text-primary fw-bold" href="#"><i class="bi bi-lightning-charge-fill me-1"></i> Flash API</a>
            <div class="d-flex align-items-center gap-3">
                <span class="text-light small-muted d-none d-md-inline">APIKEY: <strong class="text-secondary"><%= userId %></strong></span>
                <a href="/manager/logout" class="btn btn-sm btn-danger">
                    <i class="bi bi-box-arrow-right me-1"></i> Sair
                </a>
            </div>
        </div>
    </nav>

    <div class="container mt-4">

        <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <div id="userInfo" data-instance="<%= JSON.stringify(instances) %>" data-apikey="<%= userId %>"></div>

        <!-- ─── Instâncias ──────────────────────────────────────────── -->
        <section class="mb-5">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <h4 class="text-primary mb-0"><i class="bi bi-phone me-2"></i>Minhas Instâncias</h4>
                <button class="btn btn-sm btn-outline-secondary" id="btnRefreshRecipients" type="button">
                    <i class="bi bi-arrow-repeat me-1"></i> Atualizar contatos/grupos
                </button>
            </div>
            <div class="row g-4">
                <% instances.forEach(instance => { %>
                    <div class="col-md-6 col-lg-4">
                        <div class="card-instance" data-nome="<%= instance.nome_sessao %>" data-apikey="<%= instance.apikey %>">

                            <!-- Header: foto + info -->
                            <div class="top-row mb-3">
                                <div class="d-flex align-items-center gap-3 flex-grow-1">
                                    <img
                                        src="/api/session/avatar/<%= instance.apikey %>?t=<%= Date.now() %>"
                                        alt="Foto de perfil"
                                        class="instance-avatar"
                                    >
                                    <div class="flex-grow-1 overflow-hidden">
                                        <h5 class="text-primary mb-1 text-truncate">📱 <%= instance.nome_sessao %></h5>
                                        <div class="small-muted text-truncate">🔑 <%= instance.apikey %></div>
                                        <% if (instance.numero) { %>
                                            <div class="small-muted">📞 <strong><%= instance.numero %></strong></div>
                                        <% } %>
                                    </div>
                                </div>
                                <div class="meta mt-1">
                                    <button class="btn copiar-btn" data-copy="<%= instance.nome_sessao %>" title="Copiar nome" aria-label="Copiar nome">
                                        <i class="bi bi-clipboard"></i>
                                    </button>
                                    <button class="btn copiar-btn" data-copy="<%= instance.apikey %>" title="Copiar APIKey" aria-label="Copiar APIKey">
                                        <i class="bi bi-clipboard-data"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Status -->
                            <p class="mb-3">
                                📊 Status:
                                <% if (instance.status === 'connected') { %>
                                    <span class="status-connected-badge"><i class="bi bi-check-circle-fill"></i> Conectado</span>
                                <% } else { %>
                                    <span class="status-disconnected-badge"><i class="bi bi-x-circle-fill"></i> Desconectado</span>
                                <% } %>
                            </p>

                            <!-- Ações -->
                            <div class="row row-cols-2 g-2">
                                <% if (instance.status !== 'connected') { %>
                                    <div class="col">
                                        <button class="btn-generate btn btn-sm btn-success w-100" data-id="<%= instance.id %>">
                                            <i class="bi bi-plug-fill me-1"></i><span class="btn-text">Conectar</span>
                                            <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                                        </button>
                                    </div>
                                <% } else { %>
                                    <div class="col">
                                        <button class="btn-restart btn btn-sm btn-success w-100" data-id="<%= instance.id %>">
                                            <i class="bi bi-arrow-repeat me-1"></i><span class="btn-text">Reiniciar</span>
                                            <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                                        </button>
                                    </div>
                                <% } %>

                                <div class="col">
                                    <button class="btn-disconnect btn btn-sm btn-danger w-100" data-id="<%= instance.id %>">
                                        <i class="bi bi-power me-1"></i><span class="btn-text">Desconectar</span>
                                        <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                                    </button>
                                </div>

                                <div class="col">
                                    <button class="btn-config btn btn-sm btn-secondary w-100" data-id="<%= instance.id %>">
                                        <i class="bi bi-gear me-1"></i><span class="btn-text">Configuração</span>
                                    </button>
                                </div>

                                <div class="col">
                                    <button class="btn-enviar btn btn-sm btn-primary w-100" data-id="<%= instance.id %>" data-apikey="<%= instance.apikey %>">
                                        <i class="bi bi-send me-1"></i><span class="btn-text">Enviar msg</span>
                                    </button>
                                </div>
                            </div>

                        </div>
                    </div>
                <% }) %>
            </div>
        </section>

        <!-- ─── Envio de Mensagem ───────────────────────────────────── -->
        <section class="mb-5" id="messageStudioSection">
            <h4 class="text-primary mb-3"><i class="bi bi-send me-2"></i>Envio de Mensagem</h4>
            <div class="data-panel">
                <form id="messageStudioForm">
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label small-muted">Instância</label>
                            <select id="msgInstanceSelect" class="form-select"></select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small-muted">Tipo de mensagem</label>
                            <select id="messageType" class="form-select">
                                <option value="text">Texto</option>
                                <option value="image">Imagem</option>
                                <option value="video">Vídeo</option>
                                <option value="audio">Áudio</option>
                                <option value="document">Documento</option>
                                <option value="location">Localização</option>
                                <option value="poll">Enquete</option>
                                <option value="sticker">Sticker</option>
                                <option value="contact">Contato (vCard)</option>
                                <option value="reaction">Reação</option>
                                <option value="typing">Digitando</option>
                                <option value="mark-read">Marcar como lido</option>
                                <option value="list">Lista</option>
                                <option value="buttons">Botões</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small-muted">Delay (ms)</label>
                            <input type="number" id="messageDelay" class="form-control" value="1200" min="0">
                        </div>
                    </div>

                    <!-- Destinos -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label small-muted">Modo de destino</label>
                            <select id="targetMode" class="form-select">
                                <option value="selected">Selecionados</option>
                                <option value="manual">Manual (JIDs)</option>
                                <option value="mixed">Misto</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small-muted d-flex justify-content-between">
                                <span>Contatos / Grupos</span>
                            </label>
                            <select id="targetMultiSelect" class="form-select" multiple style="height:120px;"></select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small-muted">JIDs manuais (um por linha)</label>
                            <textarea id="manualTargets" class="form-control" rows="4" placeholder="5521999999999&#10;5511888888888"></textarea>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-auto">
                            <div class="form-check form-check-inline">
                                <input type="checkbox" id="messageUseQueue" class="form-check-input">
                                <label for="messageUseQueue" class="form-check-label small-muted">Usar fila</label>
                            </div>
                        </div>
                    </div>

                    <!-- Campos dinâmicos por tipo -->
                    <div id="messageTypeFields">

                        <div class="message-type-fields" data-type="text">
                            <div class="mb-2">
                                <label class="form-label small-muted">Texto</label>
                                <textarea id="fieldText" class="form-control" rows="3" placeholder="Olá! 😊"></textarea>
                            </div>
                            <div class="form-check">
                                <input type="checkbox" id="fieldLinkPreview" class="form-check-input">
                                <label for="fieldLinkPreview" class="form-check-label small-muted">Link preview</label>
                            </div>
                        </div>

                        <div class="message-type-fields d-none" data-type="image">
                            <div class="mb-2">
                                <label class="form-label small-muted">URL ou base64 da imagem</label>
                                <input type="text" id="fieldImage" class="form-control" placeholder="https://...">
                            </div>
                            <div class="mb-2">
                                <label class="form-label small-muted">Legenda</label>
                                <input type="text" id="fieldImageCaption" class="form-control">
                            </div>
                        </div>

                        <div class="message-type-fields d-none" data-type="video">
                            <div class="mb-2">
                                <label class="form-label small-muted">URL ou base64 do vídeo</label>
                                <input type="text" id="fieldVideo" class="form-control" placeholder="https://...">
                            </div>
                            <div class="mb-2">
                                <label class="form-label small-muted">Legenda</label>
                                <input type="text" id="fieldVideoCaption" class="form-control">
                            </div>
                            <div class="form-check">
                                <input type="checkbox" id="fieldGifPlayback" class="form-check-input">
                                <label for="fieldGifPlayback" class="form-check-label small-muted">GIF</label>
                            </div>
                        </div>

                        <div class="message-type-fields d-none" data-type="audio">
                            <div class="mb-2">
                                <label class="form-label small-muted">URL ou base64 do áudio</label>
                                <input type="text" id="fieldAudio" class="form-control" placeholder="https://...">
                            </div>
                            <div class="form-check">
                                <input type="checkbox" id="fieldPtt" class="form-check-input" checked>
                                <label for="fieldPtt" class="form-check-label small-muted">PTT (mensagem de voz)</label>
                            </div>
                        </div>

                        <div class="message-type-fields d-none" data-type="document">
                            <div class="mb-2">
                                <label class="form-label small-muted">URL ou base64 do documento</label>
                                <input type="text" id="fieldDocument" class="form-control" placeholder="https://...">
                            </div>
                            <div class="row g-2">
                                <div class="col">
                                    <label class="form-label small-muted">Nome do arquivo</label>
                                    <input type="text" id="fieldFileName" class="form-control" placeholder="arquivo.pdf">
                                </div>
                                <div class="col">
                                    <label class="form-label small-muted">Mimetype</label>
                                    <input type="text" id="fieldMimeType" class="form-control" placeholder="application/pdf">
                                </div>
                            </div>
                            <div class="mb-2 mt-2">
                                <label class="form-label small-muted">Legenda</label>
                                <input type="text" id="fieldDocumentCaption" class="form-control">
                            </div>
                        </div>

                        <div class="message-type-fields d-none" data-type="location">
                            <div class="row g-2 mb-2">
                                <div class="col">
                                    <label class="form-label small-muted">Latitude</label>
                                    <input type="number" id="fieldLatitude" class="form-control" step="any" placeholder="-23.5505">
                                </div>
                                <div class="col">
                                    <label class="form-label small-muted">Longitude</label>
                                    <input type="number" id="fieldLongitude" class="form-control" step="any" placeholder="-46.6333">
                                </div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small-muted">Nome do local</label>
                                <input type="text" id="fieldLocationName" class="form-control" placeholder="São Paulo">
                            </div>
                            <div class="mb-2">
                                <label class="form-label small-muted">Endereço</label>
                                <input type="text" id="fieldLocationAddress" class="form-control" placeholder="Av. Paulista, 1000">
                            </div>
                        </div>

                        <div class="message-type-fields d-none" data-type="poll">
                            <div class="mb-2">
                                <label class="form-label small-muted">Pergunta</label>
                                <input type="text" id="fieldPollName" class="form-control" placeholder="Qual o melhor framework?">
                            </div>
                            <div class="mb-2">
                                <label class="form-label small-muted">Opções (uma por linha)</label>
                                <textarea id="fieldPollOptions" class="form-control" rows="4" placeholder="Express&#10;Fastify&#10;NestJS"></textarea>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small-muted">Máx. selecionáveis</label>
                                <input type="number" id="fieldPollSelectableCount" class="form-control" value="1" min="0">
                            </div>
                        </div>

                        <div class="message-type-fields d-none" data-type="sticker">
                            <div class="mb-2">
                                <label class="form-label small-muted">URL ou base64 do sticker</label>
                                <input type="text" id="fieldSticker" class="form-control" placeholder="https://...">
                            </div>
                        </div>

                        <div class="message-type-fields d-none" data-type="contact">
                            <div class="mb-2">
                                <label class="form-label small-muted">Nome do contato</label>
                                <input type="text" id="fieldContactName" class="form-control" placeholder="João Silva">
                            </div>
                            <div class="mb-2">
                                <label class="form-label small-muted">vCard</label>
                                <textarea id="fieldContactVcard" class="form-control" rows="5" placeholder="BEGIN:VCARD&#10;VERSION:3.0&#10;FN:João Silva&#10;TEL:+5521999999999&#10;END:VCARD"></textarea>
                            </div>
                        </div>

                        <div class="message-type-fields d-none" data-type="reaction">
                            <div class="mb-2">
                                <label class="form-label small-muted">ID da mensagem</label>
                                <input type="text" id="fieldReactionMessageId" class="form-control" placeholder="ABCD1234...">
                            </div>
                            <div class="mb-2">
                                <label class="form-label small-muted">Emoji</label>
                                <input type="text" id="fieldReactionEmoji" class="form-control" placeholder="👍">
                            </div>
                        </div>

                        <div class="message-type-fields d-none" data-type="typing">
                            <div class="mb-2">
                                <label class="form-label small-muted">Status</label>
                                <select id="fieldTyping" class="form-select">
                                    <option value="true">Digitando</option>
                                    <option value="false">Parado</option>
                                </select>
                            </div>
                        </div>

                        <div class="message-type-fields d-none" data-type="mark-read">
                            <div class="mb-2">
                                <label class="form-label small-muted">ID da mensagem (opcional)</label>
                                <input type="text" id="fieldMarkReadMessageId" class="form-control" placeholder="Deixe vazio para marcar todo o chat">
                            </div>
                        </div>

                        <div class="message-type-fields d-none" data-type="list">
                            <div class="mb-2">
                                <label class="form-label small-muted">JSON do listMessage</label>
                                <textarea id="fieldListJson" class="form-control font-monospace" rows="6" placeholder='{"buttonText":"Ver opções","sections":[{"title":"Seção","rows":[{"rowId":"op1","title":"Opção 1"}]}]}'></textarea>
                            </div>
                        </div>

                        <div class="message-type-fields d-none" data-type="buttons">
                            <div class="mb-2">
                                <label class="form-label small-muted">Texto</label>
                                <input type="text" id="fieldButtonsText" class="form-control" placeholder="Escolha uma opção:">
                            </div>
                            <div class="mb-2">
                                <label class="form-label small-muted">Rodapé</label>
                                <input type="text" id="fieldButtonsFooter" class="form-control" placeholder="Flash API">
                            </div>
                            <div class="mb-2">
                                <label class="form-label small-muted">JSON dos botões</label>
                                <textarea id="fieldButtonsJson" class="form-control font-monospace" rows="4" placeholder='[{"buttonId":"btn1","buttonText":{"displayText":"Opção 1"}}]'></textarea>
                            </div>
                        </div>

                    </div>

                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-send me-1"></i> Enviar
                        </button>
                        <button type="button" id="btnClearMessageForm" class="btn btn-secondary">
                            <i class="bi bi-x-circle me-1"></i> Limpar
                        </button>
                    </div>
                </form>

                <div id="messageStudioResult" class="result-box mt-3 d-none"></div>
            </div>
        </section>

        <!-- ─── Gerenciador de Grupos ────────────────────────────────── -->
        <section class="mb-5">
            <h4 class="text-primary mb-3"><i class="bi bi-people me-2"></i>Gerenciador de Grupos</h4>
            <div class="data-panel">
                <form id="groupManagerForm">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small-muted">Instância</label>
                            <select id="groupInstanceSelect" class="form-select"></select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small-muted">Ação</label>
                            <select id="groupAction" class="form-select">
                                <option value="info">Informações do grupo</option>
                                <option value="create">Criar grupo</option>
                                <option value="add-participant">Adicionar participante</option>
                                <option value="remove-participant">Remover participante</option>
                                <option value="promote">Promover a admin</option>
                                <option value="demote">Rebaixar admin</option>
                                <option value="update-subject">Atualizar nome</option>
                                <option value="update-description">Atualizar descrição</option>
                                <option value="leave">Sair do grupo</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small-muted">JID do grupo</label>
                            <input type="text" id="groupJid" class="form-control" placeholder="1234567890@g.us">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small-muted">Participantes (um por linha)</label>
                            <textarea id="groupParticipants" class="form-control" rows="3" placeholder="5521999999999&#10;5511888888888"></textarea>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small-muted">Novo nome do grupo</label>
                            <input type="text" id="groupSubject" class="form-control" placeholder="Nome do grupo">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small-muted">Nova descrição</label>
                            <input type="text" id="groupDescription" class="form-control" placeholder="Descrição do grupo">
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-gear me-1"></i> Executar
                    </button>
                </form>
                <div id="groupManagerResult" class="result-box mt-3 d-none"></div>
            </div>
        </section>

    </div>

    <!-- ─── Modal QR Code ────────────────────────────────────────── -->
    <div class="modal fade" id="modalQR" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="modalQRLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content bg-dark text-white">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalQRLabel">📱 Conectar WhatsApp</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body text-center">
                    <div id="qr-code-info" class="mb-2"></div>
                    <img id="qr-code-img" class="img-fluid mt-2 border border-light rounded shadow" style="max-width:300px;" />
                    <div id="info-detalhes" class="mt-2"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ─── Modal Configuração ──────────────────────────────────── -->
    <div class="modal fade" id="configSessao" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="configSessaoLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content bg-dark text-white border border-primary">
                <div class="modal-header">
                    <h5 class="modal-title text-primary" id="configSessaoLabel">⚙️ Configuração da Sessão</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>

                <form id="form-config-Instance">
                    <div class="modal-body">

                        <div class="mb-3">
                            <label class="form-label text-secondary">🔗 URL Webhook</label>
                            <div class="input-group">
                                <span class="input-group-text border-primary border-2">URL:</span>
                                <input type="text" id="webhook-url" class="form-control border-primary border-2" placeholder="https://meuwebhook.com/api/receber">
                            </div>
                            <div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox" id="webhook-status">
                                <label class="form-check-label" for="webhook-status">✅ Ativar webhook</label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-secondary">📋 Eventos do webhook</label>
                            <select class="form-select" name="events[]" id="events[]" multiple style="height:130px;">
                                <option value="connection_update">connection_update</option>
                                <option value="qr_updated">qr_updated</option>
                                <option value="message_received">message_received</option>
                                <option value="message_update">message_update</option>
                                <option value="chats_set">chats_set</option>
                                <option value="chats_update">chats_update</option>
                                <option value="contacts_set">contacts_set</option>
                                <option value="contacts_update">contacts_update</option>
                                <option value="groups_update">groups_update</option>
                                <option value="group_participants_update">group_participants_update</option>
                                <option value="presence_update">presence_update</option>
                                <option value="call">call</option>
                                <option value="messaging_history_set">messaging_history_set</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-secondary">🚫 Mensagem de rejeição</label>
                            <div class="input-group">
                                <span class="input-group-text border-primary border-2">Msg:</span>
                                <input type="text" id="mensagem-rejeicao" class="form-control border-primary border-2" placeholder="Chamada recusada.">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-6">
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox" id="rejeitar-chamada">
                                    <label class="form-check-label" for="rejeitar-chamada">📞 Rejeitar chamadas</label>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox" id="ignorar-grupos">
                                    <label class="form-check-label" for="ignorar-grupos">👥 Ignorar grupos</label>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox" id="sempre-online">
                                    <label class="form-check-label" for="sempre-online">🟢 Sempre online</label>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox" id="proxy-ativo">
                                    <label class="form-check-label" for="proxy-ativo">🟢 Proxy Ativo</label>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3 d-none" id="config-proxy">
                            <div class="mb-3 col-6">
                                <div class="input-group">
                                    <span class="input-group-text border-primary border-2">Protocol:</span>
                                    <input type="text" id="proxy-protocol" class="form-control border-primary border-2" placeholder="ex: http">
                                </div>
                            </div>

                            <div class="mb-3 col-6">
                                <div class="input-group">
                                    <span class="input-group-text border-primary border-2">Username:</span>
                                    <input type="text" id="proxy-username" class="form-control border-primary border-2" placeholder="ex: user123">
                                </div>
                            </div>

                            <div class="mb-3 col-6">
                                <div class="input-group">
                                    <span class="input-group-text border-primary border-2">Password:</span>
                                    <input type="text" id="proxy-password" class="form-control border-primary border-2" placeholder="ex: pass123">
                                </div>
                            </div>

                            <div class="mb-3 col-6">
                                <div class="input-group">
                                    <span class="input-group-text border-primary border-2">Port:</span>
                                    <input type="text" id="proxy-port" class="form-control border-primary border-2" placeholder="ex: 8080">
                                </div>
                            </div>

                            <div class="mb-3 col-6">
                                <div class="input-group">
                                    <span class="input-group-text border-primary border-2">Host:</span>
                                    <input type="text" id="proxy-host" class="form-control border-primary border-2" placeholder="ex: 127.0.0.1">
                                </div>
                            </div>
                        </div>

                        <div id="id_sessao" data-id=""></div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                        <button type="submit" class="btn btn-primary">
                            <span class="btn-text">💾 Salvar</span>
                            <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

