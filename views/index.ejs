<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login | Flash-API</title>

    <!-- Bootstrap -->
    <link href="/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/css/futuristic-theme.css" rel="stylesheet" />

    <!-- jQuery -->
    <script src="/js/jquery.min.js"></script>

    <!-- Axios -->
    <script src="/js/axios.js"></script>

</head>

<body class="login-page">
    <div class="login-box">
        <div class="text-center mb-4">
            <h2 class="text-primary fw-bold">Flash-API</h2>
            <p class="text-secondary">Entre com sua APIKEY</p>
        </div>

        <form method="post" action="/manager/login">

            <div class="mb-3 input-group">
                <span for="apikey" class="input-group-text">ApiKey</span>
                <input type="text" class="form-control" id="apikey" name="apikey" required />
            </div>

            <div class="d-grid mb-3">
                <button type="submit" class="btn btn-primary">Entrar</button>
            </div>
            <% if (error) { %>
                <div id="alertError" class="alert alert-<%= error.icon %>" role="alert">
                    <%= error.message %>
                </div>
                <% } %>
        </form>
    </div>

    <script src="/js/login.js"></script>
</body>

</html>